    "@vitejs/plugin-react": "^5.1.2",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.9.0",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.66.0",
